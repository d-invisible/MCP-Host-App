# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
DEBUG=true
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3001

# ---- database -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://mcphost:mcphost@localhost:5432/mcphost
DB_ECHO=false

# ---- secrets --------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# TOKEN_ENCRYPTION_KEY encrypts third-party OAuth tokens via pgcrypto.
# Changing it makes every stored token undecryptable, forcing reconnection.
TOKEN_ENCRYPTION_KEY=CHANGE_ME_generate_a_long_random_value
JWT_SECRET_KEY=CHANGE_ME_generate_a_different_long_random_value

# ---- LLM ------------------------------------------------------------------
# Pick ONE of the two blocks. When the Azure block is filled in it takes
# precedence over the OpenAI block.

# Azure AI Foundry. DEPLOYMENT is the name you gave the deployment in the
# Foundry portal, which is not necessarily the underlying model name.
AZURE_AI_FOUNDRY_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_DEPLOYMENT=gpt-4.1-mini

# Plain OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5

# ---- CORS -----------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3001"]
