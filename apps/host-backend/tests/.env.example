# Test configuration (optional)
#
# The suite needs no configuration to run:
#
#     uv run pytest -q
#
# Unit tests construct their own Settings and never read a .env file. The tests
# in test_auth_flow.py drive a live backend, and skip automatically when one is
# not reachable — so a bare checkout still gets a green run.
#
# Copy to .env only if you need to override the defaults below. This directory's
# .env is gitignored; this template is not.

# Backend to run the live auth tests against.
# Default: http://127.0.0.1:8000
TEST_BACKEND_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Note: the tests deliberately do NOT read the application's .env. They must
# not depend on your Azure key, your database, or any real credential. Tests
# that need a database talk to the same local Postgres the app uses, through
# the app's own settings.
# ---------------------------------------------------------------------------
